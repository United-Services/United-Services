# Generated by scripts/update-cloudflare-ips.sh — never hand-edited, never
# committed. See nginx/nginx.conf's include of this directory.
nginx/cloudflare-ips.d/*.conf

# Local-only nginx config for `next dev`/`start:dev` without Docker —
# proxies :8080 to the local backend/frontend dev servers on 3002/3000,
# mirroring nginx/nginx.conf's routing so browser API calls resolve
# same-origin. Never used in production (nginx/nginx.conf is).
nginx/nginx.local.conf

# support-agent/ (Python/FastAPI)
support-agent/.env
support-agent/backend/.env
support-agent/**/__pycache__/
support-agent/**/*.pyc
# Matches backend/.venv/, ingestion/.venv/, and any other venv created
# under support-agent/ — narrower per-directory entries kept missing
# ingestion/.venv/ until this was caught.
support-agent/**/.venv/
# Scraped/chunked/embedded pipeline artifacts — regenerated by the DAG,
# not source.
support-agent/ingestion/output/
