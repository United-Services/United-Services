# Production env vars for `docker compose --env-file .env.prod up`.
# This file is a template with real production domain values filled in —
# it still has no secrets in it. Copy it to `.env` on the production host
# (or point `--env-file` at it directly) and fill in every blank value
# below from your actual secret manager/Clerk/AWS dashboards. Never commit
# a copy of this file that has real secrets filled in.

# ── Managed Postgres/Redis (production should not use the local
#    docker-compose postgres/redis containers) ──
DATABASE_URL=
DIRECT_URL=
REDIS_URL=

# Only needed if you *are* running the bundled postgres container instead
# of a managed database — leave blank when DATABASE_URL above is set.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=united_services

NGINX_PORT=80
CORS_ORIGINS=https://use-eg.com,https://www.use-eg.com
NEXT_PUBLIC_API_URL=https://use-eg.com/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
WEBAUTHN_RP_ID=use-eg.com
WEBAUTHN_ORIGIN=https://use-eg.com

# ── Clerk (production instance keys, not test/dev keys) ────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── TOTP KEK (see backend/.env.example for what this controls) ─────────
TOTP_KEK_PROVIDER=local
KEK_KEYS_DIR=/etc/use/kek-keys

# ── Betterstack (optional) ──────────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=
