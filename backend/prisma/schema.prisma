// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  client
  candidate
  admin
}

enum FileAccessStatus {
  pending
  approved
  denied
}

enum ServiceRequestStatus {
  pending
  in_review
  quoted
  closed
}

enum ApplicationStatus {
  pending
  approved
  denied
}

enum TranslatableContentType {
  open_position
  // Only name/shortDescription/longDescription — never `specs`, which is
  // technical standard codes (e.g. "API 15CLT Compliant", "DN50 – DN600")
  // that must stay as-is in every locale. See ServicesController /
  // TranslationService's SERVICE_FIELDS.
  service
}

enum TranslationStatus {
  missing
  translating
  translated
  failed
}

// ─────────────────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────────────────

// Mirrors Clerk's user record. clerkId is the source of identity; role and
// authorization decisions are always re-checked against this table, never
// trusted from a client-supplied claim.
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  role        Role
  email       String    @unique
  firstName   String
  lastName    String
  phone       String?
  companyName String? // clients only
  mfaEnrolled Boolean   @default(false) // admins only
  createdAt   DateTime  @default(now())
  disabledAt  DateTime?
  // Set whenever an admin creates an account or resets someone's password
  // with a server-generated temp password — forces a mandatory change on
  // next sign-in (see /me/change-password) before anything else in the
  // app is reachable, regardless of role.
  mustChangePassword Boolean @default(false)

  updatedServices      Service[]              @relation("ServiceUpdatedBy")
  uploadedServiceFiles ServiceFile[]          @relation("ServiceFileUploadedBy")
  fileAccessRequests   FileAccessRequest[]    @relation("FileAccessRequestClient")
  decidedFileRequests  FileAccessRequest[]    @relation("FileAccessRequestDecidedBy")
  serviceRequests      ServiceRequest[]       @relation("ServiceRequestClient")
  createdSlots         AppointmentSlot[]      @relation("AppointmentSlotCreatedBy")
  appointments         Appointment[]          @relation("AppointmentClient")
  createdPositions     OpenPosition[]         @relation("OpenPositionCreatedBy")
  candidateApplication CandidateApplication?  @relation("CandidateApplicationUser")
  reviewedApplications CandidateApplication[] @relation("CandidateApplicationReviewedBy")
  auditLogEntries      AuditLog[]             @relation("AuditLogActor")
  totpCredential       TotpCredential?
  webAuthnCredentials  WebAuthnCredential[]

  @@index([role])
  @@index([companyName])
}

// One TOTP secret per admin. `confirmedAt` is null until the admin proves
// possession of the authenticator app during enrollment; unconfirmed
// secrets don't count toward mfaEnrolled.
//
// The secret is never stored under a single symmetric key. It's envelope
// encrypted: a random per-secret DEK (AES-256-GCM) encrypts the secret
// itself (totpCiphertext/totpNonce/totpAuthTag), and the DEK is in turn
// sealed to the active KEK's public key (totpWrappedDek, an anonymous
// libsodium sealed box) — only the private key on disk for totpKekKeyId
// can unwrap it. See TotpCryptoService / KekKeyStore.
model TotpCredential {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  totpCiphertext  String
  totpNonce       String
  totpAuthTag     String
  totpWrappedDek  String
  totpKekKeyId    String
  kek             KekRegistry @relation(fields: [totpKekKeyId], references: [keyId])
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?

  @@index([totpKekKeyId])
}

// Registry of Key Encryption Keys used to envelope-encrypt TOTP secrets.
// Private keys never touch the database — only the public key (not
// secret) is stored here; the corresponding private key lives on disk at
// `KEK_KEYS_DIR/<keyId>.key`, loaded once at process start by
// KekKeyStore. "retiring" means still usable for decryption (old
// ciphertexts) but no longer used to encrypt new ones; "retired" means
// the private key file has been deleted and this row is historical only.
model KekRegistry {
  keyId     String    @id
  publicKey String
  status    String
  createdAt DateTime  @default(now())
  retiredAt DateTime?

  totpCredentials TotpCredential[]
}

// An admin may register more than one authenticator (e.g. a laptop
// fingerprint reader and a phone). publicKey/counter are opaque to us —
// only ever passed through to @simplewebauthn's verify functions.
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  deviceType   String
  backedUp     Boolean
  transports   String[]
  label        String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Services (admin-editable content) & spec files (private S3 objects)
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  longDescription  String
  // Short pill-badge specs shown on the public services page (e.g. "API
  // 15CLT Compliant", "DN50 – DN600") — admin-editable, unlike iconKey.
  specs            String[] @default([])
  // Private S3 key for the service's hero image (block-all-public-access
  // bucket, same as every other object here — see S3Service's doc comment
  // and docs/BUSINESS_RULES.md rule 9). Never a raw/permanent URL: the
  // API always resolves this to a short-lived presigned GET URL at read
  // time (see ServicesController.list/bySlug), so the DB never stores
  // anything a client could use directly.
  imageS3Key       String?
  iconKey          String
  order            Int      @default(0)
  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
  updatedByAdmin   User?    @relation("ServiceUpdatedBy", fields: [updatedByAdminId], references: [id])

  files           ServiceFile[]
  serviceRequests ServiceRequest[]

  @@index([order])
  @@index([updatedByAdminId])
}

// Always private; never publicly resolvable. Only ever reachable through
// the request → admin approval → short-lived presigned URL flow.
model ServiceFile {
  id                String   @id @default(cuid())
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  s3Key             String
  originalFilename  String
  version           Int      @default(1)
  uploadedByAdminId String
  uploadedByAdmin   User     @relation("ServiceFileUploadedBy", fields: [uploadedByAdminId], references: [id])
  uploadedAt        DateTime @default(now())

  accessRequests FileAccessRequest[]

  @@index([serviceId])
  @@index([uploadedByAdminId])
}

model FileAccessRequest {
  id                     String           @id @default(cuid())
  clientId               String
  client                 User             @relation("FileAccessRequestClient", fields: [clientId], references: [id])
  serviceFileId          String
  serviceFile            ServiceFile      @relation(fields: [serviceFileId], references: [id])
  status                 FileAccessStatus @default(pending)
  requestedAt            DateTime         @default(now())
  decidedAt              DateTime?
  decidedByAdminId       String?
  decidedByAdmin         User?            @relation("FileAccessRequestDecidedBy", fields: [decidedByAdminId], references: [id])
  downloadTokenExpiresAt DateTime?

  @@index([clientId, requestedAt])
  @@index([serviceFileId])
  @@index([status])
  @@index([decidedByAdminId])
}

// ─────────────────────────────────────────────────────────────────────────
// Service requests / RFQs
// ─────────────────────────────────────────────────────────────────────────

model ServiceRequest {
  id             String               @id @default(cuid())
  clientId       String
  client         User                 @relation("ServiceRequestClient", fields: [clientId], references: [id])
  serviceId      String?
  service        Service?             @relation(fields: [serviceId], references: [id])
  projectDetails String
  status         ServiceRequestStatus @default(pending)
  // Separate axis from `status` — whether an admin has reached out to the
  // client about this RFQ yet. Independent of the pending/in_review/
  // quoted/closed pipeline: a request can be contacted while still
  // pending, or closed without ever having been contacted.
  contactedAt    DateTime?
  createdAt      DateTime             @default(now())

  @@index([clientId, createdAt])
  @@index([status])
  @@index([serviceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Appointments
// ─────────────────────────────────────────────────────────────────────────

model AppointmentSlot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  startTime        DateTime
  endTime          DateTime
  isBooked         Boolean  @default(false)
  // Admin-only visibility toggle, independent of isBooked — a closed slot
  // (booked or not) is never returned to clients (GET /appointments/slots)
  // but stays visible to admins (GET /appointments/slots/all) for record-
  // keeping/re-opening. Distinct from cancelling a booking: closing a slot
  // hides the *timing*, cancelling a booking just changes that booking's
  // status (see Appointment.status below).
  isClosed         Boolean  @default(false)
  createdByAdminId String
  createdByAdmin   User     @relation("AppointmentSlotCreatedBy", fields: [createdByAdminId], references: [id])

  appointment Appointment?

  @@index([date])
  @@index([isBooked])
  @@index([createdByAdminId])
}

model Appointment {
  id        String            @id @default(cuid())
  slotId    String            @unique
  slot      AppointmentSlot   @relation(fields: [slotId], references: [id])
  clientId  String
  client    User              @relation("AppointmentClient", fields: [clientId], references: [id])
  status    AppointmentStatus @default(booked)
  createdAt DateTime          @default(now())

  @@index([clientId, createdAt])
  @@index([status])
}

enum AppointmentStatus {
  booked
  done
  cancelled
}

// ─────────────────────────────────────────────────────────────────────────
// Careers / candidates
// ─────────────────────────────────────────────────────────────────────────

model OpenPosition {
  id               String   @id @default(cuid())
  title            String
  description      String
  department       String
  isOpen           Boolean  @default(true)
  createdByAdminId String
  createdByAdmin   User     @relation("OpenPositionCreatedBy", fields: [createdByAdminId], references: [id])
  createdAt        DateTime @default(now())

  applications CandidateApplication[]

  // No @@index([isOpen]) here — the public listing endpoint always filters
  // WHERE isOpen = true, so a plain index would carry every closed
  // position for no benefit. Replaced by a partial index on (createdAt)
  // WHERE isOpen, added via raw SQL in the migration (Prisma's schema DSL
  // can't express a partial index's WHERE clause) — see
  // migrations/*_add_open_position_partial_index/migration.sql.
  @@index([createdByAdminId])
}

model CandidateApplication {
  id              String        @id @default(cuid())
  candidateUserId String        @unique
  candidateUser   User          @relation("CandidateApplicationUser", fields: [candidateUserId], references: [id])
  positionId      String?
  position        OpenPosition? @relation(fields: [positionId], references: [id])
  // Nullable: candidate signup creates the role='candidate' account and
  // application row up front, before any document exists. ID/CV are
  // uploaded afterward from the candidate's own dashboard (uploads.controller
  // + this row's self-service update endpoint on MeController), not as
  // part of signup.
  idPhotoS3Key         String?
  cvS3Key              String?
  dateOfBirth          DateTime          @db.Date
  status               ApplicationStatus @default(pending)
  // Set by an admin when they need the candidate to (re-)submit a
  // document; cleared automatically the next time the candidate uploads
  // anything. The candidate dashboard surfaces this + the note as a banner.
  documentsRequested     Boolean   @default(false)
  documentsRequestedNote String?
  documentsRequestedAt   DateTime?
  reviewedByAdminId      String?
  reviewedByAdmin        User?     @relation("CandidateApplicationReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt             DateTime?

  // Free-form additional documents (e.g. transcript, certificate,
  // portfolio) — distinct from idPhotoS3Key/cvS3Key because a candidate can
  // attach any number of these, unlike the single-slot ID/CV uploads.
  otherDocuments CandidateDocument[]

  @@index([positionId])
  @@index([status])
  @@index([reviewedByAdminId])
}

model CandidateDocument {
  id                String               @id @default(cuid())
  applicationId     String
  application       CandidateApplication @relation(fields: [applicationId], references: [id])
  s3Key             String
  originalFilename  String
  uploadedAt        DateTime             @default(now())

  @@index([applicationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log & analytics
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation("AuditLogActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// `country` is always resolved server-side from the request IP via
// GeoService (MaxMind GeoLite2) — never trusted from client input. Powers
// the admin dashboard's requests-by-country world map.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  metadata   Json?
  country    String?
  occurredAt DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
  @@index([country])
}

// Declaration order is load-bearing: Postgres native enums sort by their
// declared ordinal, not alphabetically, so `ORDER BY type ASC` gives the
// admin queue exactly the priority order the product wants (technical
// first, then disabled-account, then non-technical) with no extra sort
// key needed.
enum TicketType {
  technical
  disabled_account
  non_technical
}

// Freely switchable in either direction — an admin can move a ticket back
// to unresolved (e.g. a "resolved" turned out not to be), not just
// forward. Declaration order doesn't carry the same load-bearing meaning
// TicketType's does; this one's just the natural lifecycle order.
enum TicketStatus {
  unresolved
  contacted
  resolved
}

// Submitted by any visitor — signed in or not — so there is no relation
// back to User (a disabled user reporting their own lockout may not even
// be able to authenticate a request).
model Ticket {
  id              String       @id @default(cuid())
  name            String
  email           String
  company         String?
  type            TicketType
  details         String
  screenshotS3Key String?
  createdAt       DateTime     @default(now())
  status          TicketStatus @default(unresolved)
  // First time status ever moved to `contacted` — kept even if later
  // switched away, as a "when were they first reached" record; status
  // itself is the source of truth for the current state.
  contactedAt     DateTime?

  @@index([type, createdAt])
  @@index([status])
}

// Cached machine translation of a source row's translatable fields into
// one non-English locale. No hash column lives on the source row itself
// (e.g. OpenPosition) — sourceHash is computed on demand from the live
// row's current fields and compared against what's stored here, which
// means adding translation support never touches the source model's own
// write paths and can't go stale the way a stored-and-forgotten column
// on the source row could. See TranslationService.computeSourceHash.
model ContentTranslation {
  id           String                   @id @default(cuid())
  contentType  TranslatableContentType
  contentId    String
  locale       String // "ar" | "zh" only — validated in app code against routing locales minus "en"
  status       TranslationStatus        @default(missing)
  fields       Json // translated field map, e.g. { title, description, department }
  sourceHash   String // sha256 of the source fields at the moment translation succeeded
  errorMessage String?
  translatedAt DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([contentType, contentId, locale])
  @@index([status])
}
