# react-simple-maps declares a peer range of React 16-18; this project is
# on React 19 (works fine in practice, the declared range is just stale).
# Without this, every `npm install` fails with ERESOLVE.
legacy-peer-deps=true

# Waits 7 days after a version is published before npm will resolve to
# it — the same reasoning as dependabot.yml's cooldown block, applied to
# every install (not just Dependabot's own PRs): a newly-published
# version can be a compromised maintainer account or a typosquat, and
# most such incidents get caught/yanked within days. Needs npm >= 11.10
# to actually take effect — confirmed harmless on older npm (silently
# accepted, not enforced) rather than a hard error, so this is safe to
# set now regardless of what's currently installed locally or in CI.
min-release-age=7
