# ---------------------------------------------------------------------
# HTTPS for use-eg.com. Dropped into nginx/tls.d/ ONLY once the origin
# certificate and key actually exist on the server — nginx.conf includes
# this directory with a glob, so a deployment with no certificate yet
# (today's state, and every fresh checkout) simply has zero files here
# and starts exactly as it does now on plain :80. An `ssl_certificate`
# pointing at a missing file is a hard `[emerg]` that stops nginx from
# booting at all, so gating it on the file's presence — rather than
# committing it into nginx.conf — is what keeps a missing cert from
# taking the whole site down instead of just leaving it on HTTP.
#
# Certificate: a **Cloudflare Origin CA** certificate, not Let's Encrypt.
# docs/DEPLOYMENT.md step 3 puts this origin behind Cloudflare in
# orange-cloud proxy mode, which means (a) the browser-facing certificate
# is Cloudflare's, not this one, so this cert only ever has to be trusted
# by Cloudflare, and (b) an ACME HTTP-01 challenge would have to be
# tunnelled back through the proxy on every renewal. An Origin CA cert is
# free, valid for 15 years, needs no renewal automation, and is issued
# from the Cloudflare dashboard for `use-eg.com, *.use-eg.com` in one
# step. Set the zone's SSL/TLS mode to **Full (strict)** — anything less
# leaves the Cloudflare→origin leg unauthenticated and makes this whole
# block decorative.
# ---------------------------------------------------------------------

# Plain HTTP for this hostname redirects to HTTPS. Deliberately a
# name-based server rather than a change to nginx.conf's `server_name _`
# default: the default server keeps answering plain HTTP on :80 for
# direct-IP access, container healthchecks and the pre-DNS/pre-cert
# state, so installing this file can never strand a deployment that
# isn't ready for TLS yet.
server {
  listen 80;
  server_name use-eg.com www.use-eg.com;

  # Escape hatch: if the Cloudflare Origin CA path is ever abandoned for
  # Let's Encrypt, HTTP-01 needs this to stay reachable over plain HTTP.
  # Costs nothing while unused (the directory simply doesn't exist and
  # the location 404s).
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  # The modern directive. The old `listen ... http2` form is deprecated
  # since nginx 1.25.1 and warns on every `nginx -t`; docker-compose.yml
  # pins nginx:1.31-alpine, well past that.
  http2 on;

  # www is included rather than left to fail: a visitor typing
  # www.use-eg.com must not get a certificate-name mismatch (a scary
  # browser interstitial, not a 404). The Origin CA cert covers
  # *.use-eg.com, and the redirect below normalises every www request to
  # the apex so Clerk's allowed origins, the AllowedOrigin DB rows and
  # the session cookie only ever have to know about one host.
  server_name use-eg.com www.use-eg.com;

  ssl_certificate     /etc/nginx/certs/use-eg.com.pem;
  ssl_certificate_key /etc/nginx/certs/use-eg.com.key;

  ssl_protocols TLSv1.2 TLSv1.3;
  # Mozilla "intermediate" minus the DHE suites — ECDHE only, so no
  # ssl_dhparam file is needed and there is no second missing-file way
  # for nginx to fail to boot. TLS 1.3 suites are not configurable here
  # and are always the AEAD ones.
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  # Let the client pick: modern clients order their own preferences
  # better than a static server list can, and TLS 1.3 ignores this
  # setting entirely.
  ssl_prefer_server_ciphers off;

  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  # Off, not on: session tickets are encrypted with a key nginx generates
  # at start and never rotates, so a ticket key stolen later decrypts
  # every earlier session — that defeats the forward secrecy the ECDHE
  # suites above exist to provide. The shared cache covers resumption for
  # the single origin node this deployment actually runs.
  ssl_session_tickets off;

  # OCSP stapling is deliberately OFF. Cloudflare Origin CA certificates
  # carry no OCSP responder URL at all, so `ssl_stapling on` would do
  # nothing except log "no OCSP responder URL in the certificate" on
  # every start. It would also be pointless: the only client that ever
  # completes this handshake is Cloudflare's edge, and the certificate
  # the public actually validates is Cloudflare's, which Cloudflare
  # staples itself. Turn this on (with ssl_stapling_verify + a resolver)
  # only if this origin is ever moved off Cloudflare onto a publicly
  # trusted CA.

  # 0-RTT stays off (nginx default): replayable early data on an API that
  # takes real money is not worth one round trip.

  # Cloudflare Authenticated Origin Pulls — uncomment once
  # /etc/nginx/certs/cloudflare-origin-pull-ca.pem is in place. This is
  # what actually stops someone who has found the origin's IP from
  # bypassing Cloudflare's WAF and rate limiting by connecting straight
  # here with a spoofed Host header; without it the CF-Connecting-IP
  # real_ip config in nginx.conf is trivially side-stepped.
  # ssl_client_certificate /etc/nginx/certs/cloudflare-origin-pull-ca.pem;
  # ssl_verify_client on;

  # Normalise www → apex before anything else runs, so only one origin
  # ever reaches the app.
  if ($host = www.use-eg.com) {
    return 301 https://use-eg.com$request_uri;
  }

  include /etc/nginx/snippets/app-routes.conf;
}
