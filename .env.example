# Env vars for `docker compose up` (docker-compose.yml at repo root).
# Copy to `.env` in this same directory and fill in real values — never
# commit the real `.env`. See backend/.env.example for what each backend
# value means; this file is the subset docker-compose.yml actually reads.

# ── Local Postgres container (skip these and set DATABASE_URL/DIRECT_URL
#    below instead if you'd rather point at a managed Postgres, e.g. Supabase) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=united_services

# Override to use a managed Postgres/Redis instead of the local containers:
# DATABASE_URL=
# DIRECT_URL=
# REDIS_URL=

NGINX_PORT=80
CORS_ORIGINS=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api/v1
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost

# ── Clerk ────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Betterstack (optional) ──────────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=
