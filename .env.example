# Template for the .env file docker-compose.yml reads at the repo root.
# Copy this to .env and fill in real values — this file itself must never
# contain secrets (see docs/DEPLOYMENT.md "Option A" and
# docs/CREDENTIALS_CHECKLIST.md for where to get each one).
#
#   cp .env.example .env
#
# Vars marked "required" use compose's ${VAR:?...} syntax — `docker
# compose up` refuses to start without them. Everything else has a
# working default and can be left blank for local use.

# ── Local Postgres/Redis (only used if you opt into the "local-db"
#    profile: `docker compose --profile local-db up`; otherwise point
#    DATABASE_URL/DIRECT_URL/REDIS_URL below at managed services and
#    leave these three alone) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=united_services

# ── Database (Supabase or the local `postgres` service above) ────────
DATABASE_URL=
DIRECT_URL=

# ── Redis (Upstash or the local `redis` service above) ────────────────
REDIS_URL=

# ── Clerk ───────────────────────────────────────────────────────────
CLERK_SECRET_KEY=            # required
CLERK_PUBLISHABLE_KEY=       # required (also feeds NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
CLERK_WEBHOOK_SECRET=

# ── AWS S3 (service spec files) ────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Betterstack (logging) ──────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=

# ── WebAuthn (admin MFA) ────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost

# ── Self-hosted LibreTranslate (Careers page translation) ─────────
# Free, no API key — only override if you're not using the bundled
# `libretranslate` compose service.
LIBRETRANSLATE_URL=http://libretranslate:5000
TRANSLATION_MONTHLY_CHAR_BUDGET=2000000
TRANSLATION_LOCK_TTL_MS=30000
TRANSLATION_SYNC_WAIT_MS=2500

# ── Frontend / nginx ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
CORS_ORIGINS=http://localhost
NGINX_PORT=80
